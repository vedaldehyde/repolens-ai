# ==============================================================================
# RepoLens AI Backend - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="RepoLens AI"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Configuration
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage & Directory Paths (relative to backend root or absolute)
DATA_DIR="data"
REPOS_DIR="data/repos"
CHROMA_PERSIST_DIR="data/chroma"

# LLM & AI Engine (Configured for future phases; leave blank if unused in Phase 1)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
